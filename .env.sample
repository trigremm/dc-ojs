# Generate a stable per-host port from the repo URL:
# echo 'https://github.com/trigremm/dc-ojs' | md5sum - | tr -cd '[[:digit:]]' | awk '{print substr($0,1,2)}'
#  06
# 8060

# Deploy key setup for pulling private branches:
# ssh-keygen -t ed25519 -C "deploy-key-dc-ojs" -f ~/.ssh/deploy-key-dc-ojs
# eval "$(ssh-agent -s)" && ssh-add ~/.ssh/deploy-key-dc-ojs && cat ~/.ssh/deploy-key-dc-ojs.pub
# GIT_SSH_COMMAND='ssh -i ~/.ssh/deploy-key-dc-ojs' git clone git@github.com:trigremm/dc-ojs.git
# git config core.sshCommand "ssh -i ~/.ssh/deploy-key-dc-ojs"
# sudo usermod -aG docker $USER

OJS_VERSION='3.5.0-3'

OJS_DB_ROOT_PASSWORD='change_me_root_password'
OJS_DB_NAME='ojs'
OJS_DB_USER='ojs'
OJS_DB_PASSWORD='change_me_db_password'

DC_OJS_HTTP_PORT=8060

TZ='Asia/Almaty'
